# Django Core Settings
SECRET_KEY=your-super-secret-django-key
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration (Option 1: Connection URL - Recommended for Cloud MySQL like Aiven)
# Example for Aiven MySQL: mysql://avnadmin:password@host:port/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql://avnadmin:your_password@mysql-instance.aivencloud.com:port/defaultdb

# Database Configuration (Option 2: Individual variables)
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your_password
# DB_HOST=mysql-instance.aivencloud.com
# DB_PORT=3306
# DB_SSL=True

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key

# Frontend URL & CORS
FRONTEND_URL=https://your-frontend-app.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-app.onrender.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.onrender.com,https://*.onrender.com

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
